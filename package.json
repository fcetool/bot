{
  "name": "fcetool-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Professional FCETool Telegram bot on Telegram Serverless — extract partition files from remote firmware ZIPs",
  "type": "module",
  "scripts": {
    "login": "npx tgcloud login",
    "push": "npx tgcloud push",
    "status": "npx tgcloud status",
    "migrate": "npx tgcloud migrate",
    "deploy": "npx tgcloud push && npx tgcloud migrate"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "serverless",
    "fcetool",
    "firmware",
    "android",
    "boot.img"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fcetool/bot"
  }
}
